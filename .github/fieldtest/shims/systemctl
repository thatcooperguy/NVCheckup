#!/usr/bin/env bash
# Simulated systemctl: answers is-active / is-enabled / show -p ActiveState /
# status / list-units from the scenario's "systemd_units" map ({unit: state}).
# Units the DGX OS collector asks about come from spec
# docs/roadmap/spark-support.md 2.1 (dgx-dashboard.service,
# dgx-dashboard-admin.service, fwupd) and 5 (gb10-clock-cap.service,
# nvidia-persistenced, avahi, ufw). Unknown units are "inactive" (exit 3), as
# with the real tool; `show -p LoadState [--value]` answers "loaded" only for
# units the scenario lists and "not-found" otherwise (the collector uses it to
# tell an installed-but-stopped gb10-clock-cap.service from a missing one).
# Anything that would start, stop, enable, mask or edit a unit is refused.
# Never calls the real systemctl.
. "$(dirname "$0")/nvc-sim-lib.sh"

unit_name() {
  case "$1" in *.service|*.socket|*.target|*.timer|*.mount|*.path) echo "$1" ;; *) echo "$1.service" ;; esac
}
state_of() { sim_get "systemd_units.$(unit_name "$1")" inactive; }
load_state_of() { if sim_has "systemd_units.$(unit_name "$1")"; then echo loaded; else echo not-found; fi; }

cmd=""
props=""
value_only=0
units=()
while [ $# -gt 0 ]; do
  case "$1" in
    -p|--property) props="$2"; shift 2 ;;
    --property=*) props="${1#--property=}"; shift ;;
    --value) value_only=1; shift ;;
    --no-pager|--quiet|-q|--plain|--no-legend|--all|-a|--user|--system) shift ;;
    --type=*|-t) shift ;;
    -*) shift ;;
    *) if [ -z "$cmd" ]; then cmd="$1"; else units+=("$1"); fi; shift ;;
  esac
done

case "$cmd" in
  is-active)
    rc=0
    for u in "${units[@]}"; do s="$(state_of "$u")"; echo "$s"; [ "$s" = active ] || rc=3; done
    exit $rc ;;
  is-enabled)
    rc=0
    for u in "${units[@]}"; do
      if [ "$(state_of "$u")" = active ]; then echo enabled; else echo disabled; rc=1; fi
    done
    exit $rc ;;
  is-failed)
    for u in "${units[@]}"; do echo "$(state_of "$u")"; done
    exit 1 ;;
  show)
    # prop NAME VALUE: print "NAME=VALUE", or just VALUE under --value, when NAME was asked for (or no -p was given).
    prop() { if [ -z "$props" ] || [[ ",$props," == *",$1,"* ]]; then if [ "$value_only" = 1 ]; then echo "$2"; else echo "$1=$2"; fi; fi; }
    for u in "${units[@]}"; do
      s="$(state_of "$u")"
      ls="$(load_state_of "$u")"
      prop Id "$(unit_name "$u")"
      prop LoadState "$ls"
      prop ActiveState "$s"
      if [ "$s" = active ]; then prop SubState running; else prop SubState dead; fi
      if [ "$ls" = loaded ]; then
        if [ "$s" = active ]; then prop UnitFileState enabled; else prop UnitFileState disabled; fi
      fi
    done
    exit 0 ;;
  status)
    rc=0
    for u in "${units[@]}"; do
      s="$(state_of "$u")"
      if [ "$s" = active ]; then
        printf '%s - %s\n     Loaded: loaded (/usr/lib/systemd/system/%s; enabled; preset: enabled)\n     Active: active (running)\n' "$u" "$u" "$u"
      else
        printf '%s - %s\n     Loaded: loaded (/usr/lib/systemd/system/%s; disabled; preset: disabled)\n     Active: inactive (dead)\n' "$u" "$u" "$u"; rc=3
      fi
    done
    exit $rc ;;
  list-units|list-unit-files)
    sim_json systemd_units | sim_py -c '
import json, sys
d = json.load(sys.stdin)
for u, s in sorted(d.items()):
    print("%-40s loaded %-8s %s" % (u, s, "running" if s == "active" else "dead"))
'
    exit 0 ;;
  start|stop|restart|reload|enable|disable|mask|unmask|edit|daemon-reload|set-property|kill|isolate|suspend|hibernate|poweroff|reboot)
    sim_refuse systemctl "$cmd" "${units[@]}" ;;
  *)
    exit 0 ;;
esac
