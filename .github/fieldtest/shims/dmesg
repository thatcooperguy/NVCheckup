#!/usr/bin/env bash
# Simulated dmesg. Prints the scenario's "dmesg_lines" when present (gb10: a
# clean DGX OS boot with the benign mlx5 27W slot-power message of spec
# docs/roadmap/spark-support.md 3.2; gb10-gsp-fail: the Xid 119 / SEC2 / GSP
# init failure lines of 3.2). Scenarios without dmesg_lines (rig3) get the
# built-in log: a normal boot with two NVIDIA Xid errors for GPU 2 (bus 81:00),
# the classic "fallen off the bus" and an MMU fault, so the Xid collector and
# its analyzer rule run on real Linux without a GPU. Flags (-T, -k, --level)
# are accepted and ignored. Never calls the real dmesg.
. "$(dirname "$0")/nvc-sim-lib.sh"

if sim_has dmesg_lines 2>/dev/null; then
  sim_lines dmesg_lines
  exit 0
fi
