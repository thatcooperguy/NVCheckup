#!/usr/bin/env bash
# Simulated dpkg-query: serves -W/--show (with -f/--showformat), -l/--list and
# -s/--status from the scenario's "dpkg_lines" ("ii  name  version  arch
# description", the `dpkg -l` row shape). Package names, versions and the
# metapackage/DKMS placeholder come from spec docs/roadmap/spark-support.md
# 3.2. Glob patterns work like dpkg's; a pattern that matches nothing prints
# dpkg-query's "no packages found matching" message and exits 1. The real
# dpkg-query is never called.
. "$(dirname "$0")/nvc-sim-lib.sh"

sim_py - "$@" <<'PY'
import fnmatch, json, os, sys

args = sys.argv[1:]
path = os.environ.get("NVC_SIM_SCENARIO")
if not path or not os.path.exists(path):
    sys.stderr.write("nvc-sim: NVC_SIM_SCENARIO is not set or does not exist\n"); sys.exit(9)
sc = json.load(open(path, encoding="utf-8"))
lines = sc.get("dpkg_lines") or []
arch_default = "arm64" if sc.get("machine", "") in ("aarch64", "arm64") else "amd64"

pkgs = []
for ln in lines:
    parts = ln.split(None, 4)
    if len(parts) < 3:
        continue
    st = parts[0]
    pkgs.append({
        "abbrev": st, "Package": parts[1], "Version": parts[2],
        "Architecture": parts[3] if len(parts) > 3 else arch_default,
        "Description": parts[4] if len(parts) > 4 else "",
        "Status": "install ok installed" if st == "ii" else ("deinstall ok config-files" if st == "rc" else "unknown ok not-installed"),
        "StatusStatus": "installed" if st == "ii" else ("config-files" if st == "rc" else "not-installed"),
    })

mode = None
fmt = None
pats = []
i = 0
while i < len(args):
    a = args[i]
    if a in ("-W", "--show"):
        mode = "show"
    elif a in ("-l", "--list"):
        mode = "list"
    elif a in ("-s", "--status"):
        mode = "status"
    elif a in ("-f", "--showformat") and i + 1 < len(args):
        fmt = args[i + 1]; i += 1
    elif a.startswith("--showformat="):
        fmt = a.split("=", 1)[1]
    elif a.startswith("-f=") or a.startswith("-f"):
        fmt = a[3:] if a.startswith("-f=") else a[2:]
    elif a.startswith("-"):
        pass  # unknown flag, ignored
    else:
        pats.append(a)
    i += 1
if mode is None:
    sys.stderr.write("dpkg-query: error: need an action option\n"); sys.exit(2)


def matches(p):
    if not pats:
        return True
    name = p["Package"]
    return any(fnmatch.fnmatchcase(name, pat) or fnmatch.fnmatchcase(name + ":" + p["Architecture"], pat) for pat in pats)


def render(p, f):
    out = f
    repl = {
        "${Package}": p["Package"], "${binary:Package}": p["Package"], "${Version}": p["Version"],
        "${Status}": p["Status"], "${db:Status-Status}": p["StatusStatus"], "${db:Status-Abbrev}": p["abbrev"] + " ",
        "${Architecture}": p["Architecture"], "${Description}": p["Description"], "${binary:Summary}": p["Description"],
        "${Source}": p["Package"], "${Maintainer}": "", "${Installed-Size}": "0", "${Priority}": "optional", "${Section}": "misc",
    }
    for k, v in repl.items():
        out = out.replace(k, v)
    return out.replace("\\n", "\n").replace("\\t", "\t")


rc = 0
sel = [p for p in pkgs if matches(p)]
if mode == "show":
    f = fmt if fmt is not None else "${binary:Package}\\t${Version}\\n"
    for p in sel:
        sys.stdout.write(render(p, f))
    for pat in pats:
        if not any(fnmatch.fnmatchcase(p["Package"], pat) for p in pkgs):
            sys.stderr.write("dpkg-query: no packages found matching %s\n" % pat); rc = 1
elif mode == "list":
    print("Desired=Unknown/Install/Remove/Purge/Hold")
    print("| Status=Not/Inst/Conf-files/Unpacked/halF-conf/Half-inst/trig-aWait/Trig-pend")
    print("|/ Err?=(none)/Reinst-required (Status,Err: uppercase=bad)")
    print("||/ Name                                             Version                      Architecture Description")
    print("+++-================================================-============================-============-=================================")
    for p in sel:
        print("%-3s %-48s %-28s %-12s %s" % (p["abbrev"], p["Package"], p["Version"], p["Architecture"], p["Description"]))
    for pat in pats:
        if not any(fnmatch.fnmatchcase(p["Package"], pat) for p in pkgs):
            sys.stderr.write("dpkg-query: no packages found matching %s\n" % pat); rc = 1
elif mode == "status":
    for pat in pats:
        hit = [p for p in pkgs if p["Package"] == pat]
        if not hit:
            sys.stderr.write("dpkg-query: package '%s' is not installed and no information is available\n" % pat); rc = 1
            continue
        p = hit[0]
        print("Package: %s" % p["Package"])
        print("Status: %s" % p["Status"])
        print("Priority: optional")
        print("Section: misc")
        print("Architecture: %s" % p["Architecture"])
        print("Version: %s" % p["Version"])
        print("Description: %s" % p["Description"])
        print()
sys.exit(rc)
PY
