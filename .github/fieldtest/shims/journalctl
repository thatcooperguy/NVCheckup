#!/usr/bin/env bash
# Simulated journalctl: answers the exact read-only queries the collectors make
# from the scenario, never from the runner's own journal (whose single boot and
# real hostname would otherwise leak into the GB10 report):
#   --list-boots [--no-pager -q]                    boot table (spec 5 gb10-logless-hard-poweroff)
#   -b N [-o cat] [-n N|--lines=N] [-q]             one boot's tail (N = 0 current, -1 previous, ...)
#   -k -b [-o cat] [-g PATTERN] [--lines=N]         kernel messages of the current boot (spec 3.2 GSP /
#                                                   NVRM lines; unified-memory OOM counters; Xid fallback)
#   -b [-g PATTERN]                                 whole current boot (suspend markers, spec 5)
#   -u UNIT -b [-g PATTERN]                         one unit's lines (avahi "Host name conflict", spec 9)
# Scenario keys (all optional; without any of them the journal is empty and
# --list-boots lists only the current boot):
#   "journal_boots": [{"index": -1, "boot_id": "<32 hex>", "first": "2026-08-31 08:00:00",
#                      "last": "2026-08-31 22:15:03", "lines": ["msg", {"ident": "systemd[1]", "msg": "..."}]}]
#   "journal_units": {"avahi-daemon.service": ["msg", ...]}      current boot, per unit
#   "dmesg_lines"                                                 kernel lines of the current boot
#   "hostname"                                                    host column of the short format
# `-o cat` prints the message only; the default short format prints
# "Mon DD HH:MM:SS <hostname> <ident>: <msg>" like the real tool, so the
# redaction of journal lines is exercised. -g is case-insensitive unless the
# pattern contains an upper-case letter (journalctl's own rule). Anything that
# writes to the journal (--vacuum-*, --rotate, --flush, --sync, --setup-keys,
# --relinquish-var) is refused. Never calls the real journalctl.
. "$(dirname "$0")/nvc-sim-lib.sh"

case " $* " in
  *" --vacuum-"*|*" --rotate "*|*" --flush "*|*" --sync "*|*" --setup-keys "*|*" --relinquish-var "*|*" --smart-relinquish-var "*)
    sim_refuse journalctl "$@" ;;
esac

sim_py - "$@" <<'PY'
import hashlib, json, os, re, sys, time

args = sys.argv[1:]
path = os.environ.get("NVC_SIM_SCENARIO")
if not path or not os.path.exists(path):
    sys.stderr.write("nvc-sim: NVC_SIM_SCENARIO is not set or does not exist\n"); sys.exit(9)
sc = json.load(open(path, encoding="utf-8"))

list_boots = kernel = False
boot = None            # None: no -b given (journalctl then shows every boot; the collectors always pass -b)
units, grep, fmt, lines = [], None, "short", None
case_sensitive = None
i = 0
while i < len(args):
    a = args[i]
    nxt = args[i + 1] if i + 1 < len(args) else None
    if a == "--list-boots":
        list_boots = True
    elif a in ("-k", "--dmesg"):
        kernel = True
    elif a in ("-b", "--boot"):
        boot = 0
        if nxt is not None and re.fullmatch(r"-?\d+|[0-9a-f]{32}", nxt):
            boot = int(nxt) if re.fullmatch(r"-?\d+", nxt) else nxt; i += 1
    elif a.startswith("--boot="):
        v = a.split("=", 1)[1]; boot = int(v) if re.fullmatch(r"-?\d+", v) else v
    elif re.fullmatch(r"-b-?\d+", a):
        boot = int(a[2:])
    elif a in ("-u", "--unit") and nxt is not None:
        units.append(nxt); i += 1
    elif a.startswith("--unit="):
        units.append(a.split("=", 1)[1])
    elif a in ("-g", "--grep") and nxt is not None:
        grep = nxt; i += 1
    elif a.startswith("--grep="):
        grep = a.split("=", 1)[1]
    elif a in ("-n", "--lines") and nxt is not None:
        lines = int(nxt) if nxt.isdigit() else None; i += 1
    elif a.startswith("--lines="):
        v = a.split("=", 1)[1]; lines = int(v) if v.isdigit() else None
    elif re.fullmatch(r"-n\d+", a):
        lines = int(a[2:])
    elif a in ("-o", "--output") and nxt is not None:
        fmt = nxt; i += 1
    elif a.startswith("--output="):
        fmt = a.split("=", 1)[1]
    elif a == "--case-sensitive" or a == "--case-sensitive=true":
        case_sensitive = True
    elif a == "--case-sensitive=false":
        case_sensitive = False
    elif a.startswith("-"):
        pass  # -q, --no-pager, -r, -x, -p, --since, ... are accepted and ignored
    i += 1

host = sc.get("hostname") or "localhost"
boots = {}
for b in sc.get("journal_boots") or []:
    boots[int(b.get("index", 0))] = b
if 0 not in boots:
    now = time.strftime("%Y-%m-%d %H:%M:%S")
    boots[0] = {"index": 0, "first": now, "last": now, "lines": []}


def boot_id(b):
    if b.get("boot_id"):
        return b["boot_id"]
    return hashlib.md5(("nvc-sim-boot-%s" % b.get("index", 0)).encode()).hexdigest()  # placeholder, not a real boot id


def entries(idx):
    """(ident, msg) rows of one boot, oldest first."""
    b = boots.get(idx)
    if b is None:
        return None
    rows = []
    if idx == 0:
        for ln in sc.get("dmesg_lines") or []:
            rows.append(("kernel", re.sub(r"^\[\s*\d+\.\d+\]\s?", "", str(ln))))
        for unit, lns in (sc.get("journal_units") or {}).items():
            for ln in lns:
                rows.append((unit.split(".")[0] + "[1]", str(ln)))
    for ln in b.get("lines") or []:
        if isinstance(ln, dict):
            rows.append((ln.get("ident", "systemd[1]"), ln.get("msg", "")))
        else:
            rows.append(("systemd[1]", str(ln)))
    if kernel:
        rows = [r for r in rows if r[0] == "kernel"]
    if units:
        want = set(u if "." in u else u + ".service" for u in units)
        rows = [r for r in rows if r[0].split("[")[0] + ".service" in want]
    return rows


def stamp(s, layout):
    try:
        return time.strftime(layout, time.strptime(str(s)[:19], "%Y-%m-%d %H:%M:%S"))
    except ValueError:
        return str(s)


if list_boots:
    print("IDX BOOT ID                          FIRST ENTRY                 LAST ENTRY")
    for idx in sorted(boots):
        b = boots[idx]
        print("%3d %s %s %s" % (idx, boot_id(b), stamp(b.get("first", ""), "%a %Y-%m-%d %H:%M:%S UTC"), stamp(b.get("last", ""), "%a %Y-%m-%d %H:%M:%S UTC")))
    sys.exit(0)

if boot is None:
    idxs = sorted(boots)
elif isinstance(boot, int):
    idxs = [boot]
else:
    idxs = [i for i in boots if boot_id(boots[i]) == boot]
rows = []
for idx in idxs:
    e = entries(idx)
    if e is None:
        sys.stderr.write("Data from the specified boot (%s) is not available: No such boot ID in journal\n" % boot)
        sys.exit(1)
    rows.extend((idx, r) for r in e)

if grep is not None:
    flags = 0 if (case_sensitive is True or (case_sensitive is None and re.search(r"[A-Z]", grep))) else re.IGNORECASE
    try:
        rx = re.compile(grep, flags)
    except re.error:
        rx = re.compile(re.escape(grep), flags)
    rows = [r for r in rows if rx.search(r[1][1])]
if lines is not None:
    rows = rows[-lines:] if lines > 0 else []

for idx, (ident, msg) in rows:
    if fmt == "cat":
        print(msg)
    else:
        print("%s %s %s: %s" % (stamp(boots[idx].get("last", ""), "%b %d %H:%M:%S"), host, ident, msg))
sys.exit(0)
PY
